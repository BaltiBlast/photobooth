<%- include("partials/head.ejs") %>

<!-- TITLE -->
<section class="title">
  <h1>Emobooth</h1>
</section>

<section class="grid-container">
  <!-- ANIMATED BUTTON -->
  <div class="infos">
    <h3>photo</h3>
    <div class="btn-grid">
      <div class="btn yellow"></div>
    </div>
  </div>

  <!-- VIDEO CONTAINER -->
  <div id="video-container">
    <span id="countdown"></span>
    <img src="/assets/png/frame.png" alt="" srcset="" />
    <video autoplay playsinline id="video" class="mirror"></video>
  </div>

  <!-- QR CODE -->
  <div class="qr-code">
    <h3>galerie</h3>
    <img src="/assets/svg/qr-code.svg" alt="qr code" />
  </div>
</section>

<!-- LINK GALLERY -->
<section class="info-footer">
  <div>
    <img class="gif" src="/assets/gif/emo-boy.gif" alt="emo boy" />
    <img class="gif" src="/assets/gif/emo-sponge-bob.gif" alt="emo boy" />
    <img class="gif" src="/assets/gif/emo-cat.gif" alt="emo boy" />
  </div>
  <p class="gallery-link">It's not a phase mom !</p>
  <div>
    <img class="gif" src="/assets/gif/emo-girl.gif" alt="emo girl" />
    <img class="gif" src="/assets/gif/emo-logan-paul.gif" alt="emo girl" />
    <img class="gif" src="/assets/gif/emo-heart.gif" alt="emo girl" />
  </div>
</section>

<!-- UI BUSY OVERLAY -->
<section id="busyLoader" hidden>
  <span class="oce-talk"></span>
  <p>Opération sur la photo en cours...</p>
</section>

<!-- PICTURE MODAL PREVIEW -->
<dialog id="modalPicturePreview">
  <article>
    <header><h2>Conserver ?</h2></header>
    <img id="pictureTaken" src="" alt="Photo prise" />
    <footer>
      <div class="btn-modal">
        <p>Oui</p>
        <div class="btn green"></div>
      </div>

      <div id="btnDeletePicture" class="btn-modal">
        <p>Non</p>
        <div class="btn red"></div>
      </div>
    </footer>
  </article>
</dialog>

<script type="module" src="/js/photobooth.script.js"></script>

<%- include("partials/footer.ejs") %>
